---
import "../styles/global.css";
import {  altPath, stripBase, SITE_URL, type Locale  } from "../lib/i18n";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  bare?: boolean;
}

const { locale, title, description, noindex = false, bare = false } = Astro.props;
const path = Astro.url.pathname;
// Astro.url.pathname 在正式環境會含 base 前綴（/cv1/），但 altPath 只認 /en/。
// 根路徑的 pathname 是 /cv1/，不先剝掉 base 會算出 /en/cv1/ 這種錯誤連結。
const pathNoBase = stripBase(path, import.meta.env.BASE_URL);
// zh 在根路徑、en 帶 /en/ 前綴，兩個語系要各自指向自己的版本
const altZh = altPath(pathNoBase, "zh");
const altEn = altPath(pathNoBase, "en");
const abs = (p: string) => new URL(p, SITE_URL).href;
---

<!doctype html>
<html lang={locale === "zh" ? "zh-Hant-TW" : "en"} class="scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(path)} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="alternate" hreflang="zh-Hant-TW" href={abs(altZh)} />
    <link rel="alternate" hreflang="en" href={abs(altEn)} />
    <link rel="alternate" hreflang="x-default" href={abs("/")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:site_name" content="Shih-Chen Liu" />
    <meta property="og:image" content={abs("/og-default.svg")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="劉士禎 / Shih-Chen Liu" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
    />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var s = localStorage.getItem("theme");
        var dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        if (dark) d.classList.add("dark");
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    {!bare && <Nav locale={locale} />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}

    <script is:inline>
      var btn = document.getElementById("theme-toggle");
      if (btn) {
        btn.addEventListener("click", function () {
          var d = document.documentElement;
          d.classList.toggle("dark");
          localStorage.setItem("theme", d.classList.contains("dark") ? "dark" : "light");
          btn.textContent = d.classList.contains("dark") ? "🌙" : "☀️";
        });
        btn.textContent = document.documentElement.classList.contains("dark") ? "🌙" : "☀️";
      }
    </script>
  </body>
</html>
