---
import {  useT, altPath, stripBase, lp  } from "../lib/i18n";

const { locale } = Astro.props;
const t = useT(locale);
const other = locale === "zh" ? "en" : "zh";
const otherLabel = locale === "zh" ? "EN" : "中文";

// Astro.url.pathname 會含 base 前綴（正式環境為 /cv1/），而 altPath 只認 /zh/、/en/。
// 不先剝掉 base，根路徑會算出 /en/cv1/ 這種錯誤連結。
const pathNoBase = stripBase(Astro.url.pathname, import.meta.env.BASE_URL);

// 語言切換：中文首頁的正式位置是 /，/zh/ 只會轉址，所以直接指 / 省一次跳轉。
let href = altPath(pathNoBase, other);
if (other === "zh" && href === "/zh/") href = "/";

// 中文首頁在 / ，英文首頁在 /en/；其餘頁面維持 /<locale>/...
const homeHref = locale === "zh" ? "/" : "/en/";

const links = [
  { href: homeHref, label: t.nav.home },
  { href: `${lp(locale, "/works/")}`, label: t.nav.works },
  { href: `${lp(locale, "/notes/")}`, label: t.nav.notes },
  { href: `${lp(locale, "/resume/")}`, label: t.nav.resume },
  { href: `${lp(locale, "/contact/")}`, label: t.nav.contact },
];
const current = pathNoBase;
const isOn = (l: { href: string }) =>
  current === l.href || (l.href !== homeHref && current.startsWith(l.href));
---

<header
  class="print-hide sticky top-0 z-50 border-b border-[var(--color-line)] bg-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] backdrop-blur"
>
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2.5 font-bold shrink-0">
      <span
        class="grid h-9 w-9 place-items-center rounded-lg bg-[var(--color-brand)] text-[var(--color-brand-fg)] text-sm"
        >Liu</span
      >
      <span class="leading-tight">
        <span class="block text-[15px]">劉士禎</span>
        <span class="block text-[11px] font-normal text-[var(--color-muted)]">Shih-Chen Liu</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-1 text-sm">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isOn(l) ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-2 transition-colors",
              isOn(l)
                ? "text-[var(--color-brand)] font-semibold"
                : "text-[var(--color-muted)] hover:text-[var(--color-fg)]",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={href}
        hreflang={other}
        aria-label={other === "en" ? "Switch to English" : "切換為繁體中文"}
        class="rounded-md border border-[var(--color-line)] px-2.5 py-1.5 text-xs font-semibold hover:bg-[var(--color-surface)]"
      >
        {otherLabel}
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-md border border-[var(--color-line)] text-base hover:bg-[var(--color-surface)]"
        aria-label="Toggle colour theme"
      >
        ☀️
      </button>
    </div>
  </div>

  <nav class="md:hidden border-t border-[var(--color-line)] overflow-x-auto" aria-label="Mobile">
    <div class="container-x flex gap-1 py-2 text-sm whitespace-nowrap">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isOn(l) ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-1.5",
              isOn(l) ? "text-[var(--color-brand)] font-semibold" : "text-[var(--color-muted)]",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
