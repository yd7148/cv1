---
/** 個資遮罩：螢幕上遮住，點擊或列印時解除 */
interface Props {
  value: string;
}
const { value } = Astro.props;
---

<span class="pii font-medium" data-pii title="點擊顯示">{value}</span>

<script is:inline>
  (function () {
    function reveal() {
      document.querySelectorAll("[data-pii]").forEach(function (el) {
        el.classList.add("is-revealed");
        el.removeAttribute("title");
      });
      try {
        sessionStorage.setItem("pii-revealed", "1");
      } catch (e) {}
    }
    try {
      if (sessionStorage.getItem("pii-revealed")) reveal();
    } catch (e) {}
    document.addEventListener("click", function (e) {
      if (
        e.target instanceof Element &&
        (e.target.closest("[data-pii]") || e.target.closest("[data-reveal]"))
      ) {
        reveal();
      }
    });
  })();
</script>
