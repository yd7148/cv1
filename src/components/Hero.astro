---
import { useT, type Locale } from "../lib/i18n";
import { identity } from "../data/resume";
import { contact } from "../data/contact";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props as Props;
const t = useT(locale);
const hasPhoto = false; // TODO: 放入 public/photo.jpg 後改為 true
---

<section class="border-b border-[var(--color-line)]">
  <div class="container-x pt-14 pb-12 sm:pt-20 sm:pb-16">
    <div class="flex flex-col sm:flex-row gap-8 sm:gap-12 items-start">
      {
        hasPhoto ? (
          <img
            src="/photo.jpg"
            alt={identity.name[locale]}
            width="320"
            height="320"
            loading="eager"
            class="w-28 h-28 sm:w-36 sm:h-36 rounded-2xl object-cover border border-[var(--color-line)] shrink-0"
          />
        ) : (
          <div
            class="w-28 h-28 sm:w-36 sm:h-36 rounded-2xl border border-dashed border-[var(--color-line)] grid place-items-center text-4xl shrink-0 print-hide"
            aria-hidden="true"
          >
            👤
          </div>
        )
      }

      <div class="min-w-0 flex-1">
        <p class="text-[var(--color-brand)] font-semibold text-sm tracking-wide">
          {identity.kicker[locale]}
        </p>
        <h1 class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-tight">
          {identity.name[locale]}
        </h1>
        <p class="mt-2 text-lg text-[var(--color-muted)]">
          {identity.currentTitle[locale]}
          <span class="mx-2 text-[var(--color-line)]">|</span>
          {identity.location[locale]}
        </p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">{contact.availability[locale]}</p>

        <p class="mt-6 text-xl sm:text-2xl font-bold leading-snug max-w-2xl">
          {identity.lead[locale]}
        </p>
        <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-muted)] max-w-3xl">
          {identity.body[locale]}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`/${locale}/resume/`} class="btn btn-primary print-hide">📄 {t.hero.ctaResume}</a>
          <a href={`/${locale}/contact/`} class="btn print-hide">✉️ {t.hero.ctaContact}</a>
        </div>

        <p class="mt-5 text-xs text-[var(--color-muted)] flex items-start gap-1.5">
          <span aria-hidden="true">🔒</span>
          <span>{t.hero.privacyNote}</span>
        </p>
      </div>
    </div>
  </div>
</section>
